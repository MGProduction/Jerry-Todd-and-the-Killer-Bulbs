dt=Text
<node>
withobj:$every
3
ifobjin:$this,$here
	ifobj:$this,takeable+visible
		putobj:$this,$inventory
		msg:Fatto.
	else
		msg:Meglio lasciare tutto al suo posto.
	endif
else
	ifobjin:$this,$inventory
		msg:Hai già ciò che cerchi di prendere.
	else
		msg:Qui non c'è.
	endif
endif

<end node> 5P9i0s8y19Z
