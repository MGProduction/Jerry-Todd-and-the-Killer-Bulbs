dt=Text
<node>
withobj:$every
3
ifobjin:$this,$here
	ifobj:$this,takeable+visible
		putobj:$this,$inventory
		msg:Done.
	else
		msg:It is better left where it is.
	endif
else
	ifobjin:$this,$inventory
		msg:You already have it.
	else
		msg:That is not here.
	endif
endif

