<end node> 5P9i0s8y19Z
dt=Text
<node>
name:Cap Tinkertop
3
<end node> 5P9i0s8y19Z
dt=Text
<node>
desc
3
Cap Tinkertop, il vecchio amico della banda.

<end node> 5P9i0s8y19Z
dt=Text
<node>
startat:$nowhere
3
<end node> 5P9i0s8y19Z
dt=Text
<node>
syn:cap,capitano,tinkertop
3
<end node> 5P9i0s8y19Z
dt=Text
<node>
verb
3
<end node> 5P9i0s8y19Z
dt=Text
<node>
x
4
ifobjin:cap,$available
	if:cap_free
		msg:Cap è scosso, ma riesce a camminare con un po' di aiuto.
	else
		msg:Cap ha i polsi legati dietro la schiena. È vivo e bisogna liberarlo subito.
	endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
talk
4
ifobjin:cap,$available
	if:cap_free
		msg:"La signora Bulb è andata a chiamare suo marito", dice Cap. "Vuole farmi tacere. Chiamate Bill e tenete chiusa quella porta!"
	else
		msg:Cap riesce soltanto a emettere suoni soffocati. Prima bisogna liberarlo dalle corde.
	endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
untie
4
ifobjin:cap,$available
	if:cap_free
		msg:Cap è già libero.
	else
		set:cap_free
		set:danger
		put:cap,potting_room
		msg:Red scioglie i nodi mentre Peg sorregge Cap. "Una distilleria clandestina!" ansima Cap. "L'ho scoperta mentre riparavo l'impianto di irrigazione. La signora Bulb è andata a chiamare suo marito. Se riesce a entrare, mi ucciderà."
		msg:Scoop accompagna Cap nella stanza dei rinvasi. "Jerry deve andare a chiamare Bill. Noi puntelleremo la porta."
		waitkey
		goto:potting_room
	endif

<end node> 5P9i0s8y19Z
