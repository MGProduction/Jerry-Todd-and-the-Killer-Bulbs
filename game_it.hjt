dt=Text
<node>
untie
6
ifobjin:cap,$available
	if:cap_free
		msg:Cap è già libero.
	else
		set:cap_free
		set:danger
		put:cap,potting_room
		msg:Red scioglie i nodi mentre Peg sorregge Cap. "Una distilleria clandestina!" ansima Cap. "L'ho scoperta mentre riparavo l'impianto di irrigazione. La signora Bulb è andata a chiamare suo marito. Se riesce a entrare, mi ucciderà."
		msg:Scoop accompagna Cap nella stanza dei rinvasi. "Jerry deve andare a chiamare Bill. Noi puntelleremo la porta."
		waitkey
		goto:potting_room
	endif

<end node> 5P9i0s8y19Z
