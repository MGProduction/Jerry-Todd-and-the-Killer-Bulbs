dt=Text
<node>
withobj:gang
5
if:withfriends
	if:cap_free
		ifobjin:chair,$inventory
			msg:Scoop: "Torniamo da Cap nella stanza dei rinvasi."
		else
			if:window_opened
				msg:Scoop: "La finestra è già libera. Torniamo da Cap nella stanza dei rinvasi."
			else
				msg:Red: "Prendiamo la sedia, poi torniamo da Cap. Potrebbe servirci con la finestra bloccata."
			endif
		endif
	else
		msg:Peg: "Cap è legato! Liberiamolo, prima di tutto."
	endif
else
	msg:I tuoi amici non sono qui.
endif

