<node>
open
4
ifobjin:$this,$available
	if:crate_dug
		if:money_found
			msg:Le mazzette di banconote sono ancora dentro. La banda lascia stare le prove.
		else
			set:money_found
			msg:Peg solleva il coperchio. Non c'è Cap, ma mazzette di banconote! 
			msg:Scoop controlla l'etichetta BULB sulla cassa. 
			msg:"Quel cappello ci ha tratto in inganno. Cap dev'essere ancora al vivaio. Questi uomini stanno nascondendo i loro incassi."
		endif
	else
		msg:Scoop impedisce alla banda di farsi scoprire aprendo la cassa qui.
	endif

