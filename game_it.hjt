dt=Text
<node>
onenter
2
clear
ifundef:$room.shortdesc
	msg:Ti trovi in +
	msg:$roomname
else
	msg:Ti trovi +
	msg:$room.shortdesc
endif
msg:.
ifundef:$room.exits
	msg:Non ci sono uscite evidenti.
else
	msg:Le uscite visibili sono a +
	msg:$room.exits
	msg:.
endif
ifobjinattr:$any,$here,visible+listable
	msg:Vedi: +
	listobjin:$here,visible+listable
endif
if:withfriends
	ifisin:peg,$here
	else
		msg:Peg, Red e Scoop ti raggiungono.
	endif
	put:peg,$here
	put:red,$here
	put:scoop,$here
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
onfirst
2
clear
msg:$roomdesc
ifdef:$room.exits	
	msg:Le uscite visibili sono a +
	msg:$room.exits
	msg:.
endif
ifobjinattr:$any,$here,visible+listable
	msg:Vedi: +
	listobjin:$here,visible+listable
endif
if:withfriends
	ifisin:peg,$here
	else
		msg:Peg, Red e Scoop ti raggiungono.
	endif
	put:peg,$here
	put:red,$here
	put:scoop,$here
endif

