x
6
if:danger
	if:window_opened
		msg:Puoi passare di lì e correre da Bill. Cap non riesce certo ad arrampicarsi, e il resto della banda deve proteggerlo.
	else
		msg:La finestra è bloccata. Qualcosa di pesante potrebbe rompere il vetro; una volta liberata l'apertura, riusciresti a passarci.
	endif
else
	msg:La finestra laterale dà sulla stradina.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
use
6
if:danger
	if:help_called
		msg:Bill è stato avvertito. Tu e i tuoi amici dovete resistere nella stanza finché non riuscirà a fermare il signor Bulb.
	else
		if:boards_set		
			if:window_opened
				set:jerry_away
				unset:withfriends
				set:jerry_alone
				msg:Passi dalla finestra laterale e corri da Bill Hadley. Scoop, Peg e Red restano con Cap mentre vai a chiedere aiuto.
				waitkey
				goto:bill_office
			else
				msg:Provi a uscire dalla finestra laterale, ma è bloccata.
			endif
		else
			msg:Non vuoi lasciare i tuoi amici prima che abbiano trovato un modo per rallentare gli aggressori.
		endif
	endif
else
	msg:Per fare cosa?
endif

<end node> 5P9i0s8y19Z
