dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
	else
		if:gang_reunited
			msg:Scoop: "Torniamo alla villa. Dobbiamo scoprire cosa nascondono quegli uomini."
		else
			if:ambush_cleared
				msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
			else
				if:note_read
					if:nest_seen
						ifobjin:elastic,$inventory
							ifobjin:stone,$inventory
								msg:Red: "Hai tutto quello che serve. Torniamo al sentiero lungo il ruscello."
							else
								msg:Red: "Ora ci serve un sasso. Ne abbiamo visti lungo la riva del ruscello."
							endif
						else
							msg:Red: "Il lanciapomodori è rotto, ma possiamo staccare il suo elastico."
						endif
					else
						msg:Scoop: "Torniamo al portico di Cap e cerchiamo una strada per il vivaio."
					endif
				else
					msg:Scoop: "Andiamo da Cap. Il suo portico è a sud."
				endif
			endif
		endif
	endif
else
	msg:I tuoi amici non sono qui.
endif

