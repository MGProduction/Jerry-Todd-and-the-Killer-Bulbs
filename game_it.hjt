4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
	else
		if:gang_reunited
			msg:Scoop: "Torniamo alla villa. Dobbiamo scoprire cosa nascondono quegli uomini."
		else
			if:ambush_cleared
				msg:Scoop: "Gli Strieker sono scappati. Il sentiero a sudest porta alla stradina del paese; da lì possiamo raggiungere il vivaio."
			else
				if:nest_seen
					ifobjin:elastic,$inventory
						ifobjin:stone,$inventory
							msg:Red: "Hai elastico e sasso. Prova a colpire il nido sopra gli Strieker."
						else
							msg:Red: "L'elastico c'è. Raccogli uno di quei sassi lisci lungo la riva."
						endif
					else
						msg:Red: "Ci serve l'elastico del lanciapomodori. Torniamo al cortile del granaio."
					endif
				else
					msg:Peg: "Gli Strieker aspettano un passo falso. Guardiamo bene i cespugli prima di avvicinarci."
				endif
			endif
		endif
	endif
else
	msg:I tuoi amici non sono qui.
endif

<end node> 5P9i0s8y19Z
