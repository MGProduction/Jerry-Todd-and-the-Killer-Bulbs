	ifisroom:potting_room
		msg:Colpisci la finestra con la sedia. Il vetro va in frantumi e la sedia si spezza.
		set:window_opened
		put:chair,$nowhere
	else
		msg:Non è il momento di sedersi.

<end node> 5P9i0s8y19Z
dt=Text
<node>
x
4
ifobjin:chair,$inventory
	msg:È una solida sedia di legno.
else
	ifnot:window_opened
		ifisroom:hidden_room
			if:cap_free
				msg:È una solida sedia di legno.
			else
				msg:È una solida sedia di legno, e Cap ci è seduto sopra.
			endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
take
4
ifobjin:chair,$inventory
	msg:È già nel tuo inventario.
else
	ifisroom:hidden_room
		if:cap_free
			if:window_opened
				msg:Qui non vedi un'altra sedia.
			else
				put:chair,$inventory
				msg:Fatto.
			endif
		else
			msg:Cap ci è ancora seduto sopra!
		endif

<end node> 5P9i0s8y19Z
