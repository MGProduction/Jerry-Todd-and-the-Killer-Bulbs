unlock
6
if:money_found
	ifobjin:screwdriver,$inventory
		if:nursery_unlocked
			msg:La serratura è già sbloccata.
		else
			set:nursery_unlocked
			msg:Red lavora alla serratura con il cacciavite di Cap. Un leggero scatto premia la sua pazienza.
		endif
	else
		msg:Prima bisogna raccogliere ciò che si vuole usare.
	endif
else
	msg:Scoop ferma Red. "Non mentre lei è qui. Prima scopriamo cosa è successo."
endif

<end node> 5P9i0s8y19Z
