dt=Text
<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
	else
		if:gang_reunited
			msg:Scoop: "Torniamo alla villa. Dobbiamo scoprire cosa nascondono quegli uomini."
		else
			if:truck_seen
				msg:Scoop: "Jerry, segui quel camion! Puoi nasconderti sotto il telone."
			else
				ifobjin:truck,$available
					msg:Scoop: "Il camion è appena arrivato. Osserviamo cosa sono venuti a caricare."
				else
					if:watch_started
						msg:Scoop: "Quegli Strieker ci faranno scoprire. Peg, riesci ad allontanarli senza fare troppo rumore?"
					else
						if:tracks_seen
							msg:Scoop: "Nascondiamoci dietro i cesti e osserviamo il cortile di carico."
						else
							msg:Red: "Prima controlliamo le impronte vicino all'ingresso del vivaio."
						endif
					endif
				endif
			endif
		endif
	endif
else
	msg:I tuoi amici non sono qui.
endif

<end node> 5P9i0s8y19Z
