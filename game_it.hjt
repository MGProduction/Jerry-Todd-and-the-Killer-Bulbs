	if:money_found
		ifobjin:screwdriver,$inventory
			msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
		else
			msg:Red: "Prendiamo il cacciavite prima di tornare al vivaio."
		endif
	else
		if:gang_reunited
			msg:Scoop: "Torniamo alla villa. Dobbiamo scoprire cosa nascondono quegli uomini."
		else
			if:note_read
				if:ambush_cleared
					msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
				else
					msg:Scoop: "Sappiamo dove cercare Cap: andiamo al vivaio."
				endif
			else
				msg:Scoop: "Quel biglietto sul tavolo potrebbe spiegare dove è andato Cap."
			endif
		endif
	endif
else
	msg:Gli altri aspettano tue notizie: non sono qui con te.
endif

