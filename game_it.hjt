dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
	else
		if:gang_reunited
			msg:Scoop: "Torniamo alla villa. Dobbiamo scoprire cosa nascondono quegli uomini."
		else
			if:ambush_cleared
				msg:Scoop: "La strada a sud è libera. Torniamo al vivaio."
			else
				if:note_read
					if:nest_seen
						ifobjin:elastic,$inventory
							msg:Red: "Torniamo al sentiero lungo il ruscello. Lì possiamo usare l'elastico e cercare un sasso."
						else
							msg:Red: "Torniamo al cortile del granaio a prendere l'elastico del lanciapomodori."
						endif
					else
						if:smith_seen
							msg:Scoop: "La signora Smith è ancora sulla strada a sud. Proviamo il sentiero a sudovest."
						else
							msg:Scoop: "Cap è stato chiamato al vivaio. Vediamo quale strada possiamo prendere."
						endif
					endif
				else
					if:capdoor_unlocked
						msg:Scoop: "Entriamo a vedere se Cap ha lasciato un messaggio."
					else
						if:key_found
							ifobjin:sparekey,$inventory
								msg:Red: "Proviamo la chiave nella serratura."
							else
								msg:Red: "La chiave è sotto il vaso. Non lasciamola lì."
							endif
						else
							msg:Red: "Cap mi aveva mostrato una chiave di riserva sotto quel vaso."
						endif
					endif
				endif
			endif
		endif
	endif
else
	msg:I tuoi amici non sono qui.
endif

<end node> 5P9i0s8y19Z
