dt=Text
<node>
withobj:gang
5
if:jerry_away
	msg:I tuoi amici stanno proteggendo Cap al vivaio. Racconta subito a Bill cosa sta succedendo.
else
	if:withfriends
		if:note_read
			msg:Scoop: "Per chiedere aiuto a Bill ci serve qualcosa di più di un appuntamento mancato. Cerchiamo Cap al vivaio."
		else
			msg:Scoop: "Prima andiamo da Cap: ci aveva promesso un lavoro."
		endif
	else
		msg:I tuoi amici non sono qui.
	endif
endif

<end node> 5P9i0s8y19Z
