else
	if:bulb_away
		msg:La signora Bulb ha chiuso a chiave quando se n'è andata. Red studia la piccola serratura.
	else
		msg:La signora Bulb tiene la serra privata chiusa ai visitatori.
	endif
endif

<end node> 5P9i0s8y19Z
dt=Text
