dt=Text
<node>
run
4
if:danger
	if:help_called
		msg:Bill è stato avvertito. Tu e i tuoi amici dovete resistere nella stanza finché non riuscirà a fermare il signor Bulb.
	else
		if:boards_set		
			if:window_opened
				set:jerry_away
				unset:withfriends
				set:jerry_alone
				msg:Passi dalla finestra laterale e corri da Bill Hadley. Scoop, Peg e Red restano con Cap mentre vai a chiedere aiuto.
				waitkey
				goto:bill_office
			else
				msg:Provi a uscire dalla finestra laterale, ma è bloccata.
			endif
		else
			msg:Non vuoi lasciare i tuoi amici prima che abbiano trovato un modo per rallentare gli aggressori.
		endif
	endif
else
	msg:Per fare cosa?
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
s
4
if:danger
	msg:Fuori si avvicinano passi pesanti. La banda deve proteggere Cap qui; puoi usare la finestra laterale.
else
	goto:glasshouse
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
wait
4
if:danger
	if:help_called
		if:bench_set
			if:boards_set
				msg:Il signor Bulb si scaglia contro la porta. Peg tiene fermo il banco; i puntelli di Red reggono. Scoop tiene Cap al riparo. Fuori, Bill grida un ordine. Sono arrivati i soccorsi!
				waitkey
				goto:_end
			else
				addvar:pressure,1
				msg:Il banco si sposta sotto un colpo. Red indica le assi: "Puntelliamolo!"
				if:pressure>2
					waitkey
					goto:_caught
				endif
			endif
		else
			addvar:pressure,1
			msg:Il signor Bulb è alla porta della serra. Peg deve spostare il banco prima che la porta ceda.
			if:pressure>2
				waitkey
				goto:_caught
			endif
		endif
	else
		msg:Scoop impedisce alla banda di restare in attesa. "Jerry, prima devi chiamare Bill. Usa la finestra laterale!"
	endif
else
	msg:I ragazzi si fermano ad ascoltare. Non si muove nulla.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:danger
		if:bench_set
			if:boards_set
				if:window_opened
					msg:Scoop: "La barricata è pronta e la finestra è libera. Jerry, corri a chiamare Bill!"
				else
					ifobjin:chair,$inventory
						msg:Peg: "Prova a rompere il vetro della finestra con la sedia."
					else
						msg:Red: "La finestra è bloccata. La sedia nella stanza dietro lo scaffale potrebbe aiutarci a rompere il vetro."
					endif
				endif
			else
				ifobjin:boards,$inventory
					msg:Red: "Usiamo le assi per puntellare il banco."
				else
					msg:Red: "Raccogli quelle assi. Serviranno a puntellare il banco."
				endif
			endif
		else
			msg:Peg: "Posso spostare il banco contro la porta. Poi lo puntelleremo."
		endif
	else
		if:shelf_moved
			msg:Scoop: "Passiamo dall'apertura a est. Cap potrebbe essere là dentro."
		else
			if:marks_seen
				msg:Red: "Forse lo scaffale si può spostare. Peg potrebbe provare."
			else
				msg:Red: "Diamo un'occhiata più attenta a quello scaffale."
			endif
		endif
	endif
else
	msg:I tuoi amici non sono qui.
endif

<end node> 5P9i0s8y19Z
