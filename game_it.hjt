<end node> 5P9i0s8y19Z
dt=Text
<node>
drop
4
ifobjin:$this,$available
	msg:Scoop suggerisce di conservarle finché questa faccenda non sarà risolta.

<end node> 5P9i0s8y19Z
dt=Text
<node>
use
4
ifobjin:$this,$available
	ifisroom:potting_room
		if:boards_set
			msg:Le assi sono già incastrate al loro posto.
		else
			if:danger
				ifobjin:boards,$inventory
					if:bench_set
						if:boards_set
							msg:Le assi sono già incastrate al loro posto.
						else
							set:boards_set
							put:boards,$here
							msg:Red incastra le assi tra il banco e la parete. Scoop prova il sostegno: dovrebbe reggere fino all'arrivo dei soccorsi.
						endif
					else
						msg:Prima Peg deve mettere il banco contro la porta.
					endif
				else
					msg:Prima bisogna raccogliere ciò che si vuole usare.
				endif
			else
				msg:Le assi potrebbero servire più tardi.
			endif
		endif
	else
		msg:Le assi servono nella stanza dei rinvasi.
	endif

<end node> 5P9i0s8y19Z
