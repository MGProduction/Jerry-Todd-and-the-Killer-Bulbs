<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:gang_reunited
	if:money_found
		msg:Scoop: "Torniamo al vivaio. È lì che dobbiamo cercare Cap."
	else
		if:villa_men_gone
			msg:Peg: "Gli uomini se ne sono andati. Passiamo dal varco ed entriamo in giardino."
		else
			if:crate_buried
				msg:Scoop: "Ora sappiamo dove si trova la cassa, ma gli uomini sono ancora dentro. Aspettiamo che ripartano."
			else
				msg:Peg: "Il muro è troppo alto per guardare da terra. Posso sollevarti: prova a scalarlo."
			endif
		endif
	endif
else
	msg:Gli altri aspettano tue notizie. Il camion è entrato qui: vai al telefono pubblico a sud e chiamali.
endif

<end node> 5P9i0s8y19Z
