6
if:money_found
	ifobjin:screwdriver,$inventory
		if:nursery_unlocked
			msg:The lock is already released.
		else
			set:nursery_unlocked
			msg:Red works at the lock with Cap's screwdriver. A soft click rewards his patience.
		endif
	else
		msg:Someone needs to pick that up first.
	endif
else
	msg:Scoop stops Red. "Not while she is here. Let us find out what happened first."
endif

