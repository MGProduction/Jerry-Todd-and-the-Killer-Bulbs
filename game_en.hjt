dt=Text
<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
	else
		if:gang_reunited
			msg:Scoop: "Let's go back to the villa. We need to find out what those men are hiding."
		else
			if:ambush_cleared
				msg:Scoop: "The southern lane is clear. Let's go back to the nursery."
			else
				if:note_read
					if:nest_seen
						ifobjin:elastic,$inventory
							msg:Red: "Back to the stream path. We can use the rubber band there and look for a stone."
						else
							msg:Red: "Let's go back to the barn yard and get the launcher's rubber band."
						endif
					else
						if:smith_seen
							msg:Scoop: "Mrs Smith is still on the southern lane. Let's try the path to the southwest."
						else
							msg:Scoop: "Cap was called to the nursery. Let's see which way we can go."
						endif
					endif
				else
					if:capdoor_unlocked
						msg:Scoop: "Let's go inside and see if Cap left a message."
					else
						if:key_found
							ifobjin:sparekey,$inventory
								msg:Red: "Let's try the key in the lock."
							else
								msg:Red: "The key is under the flowerpot. Don't leave it there."
							endif
						else
							msg:Red: "Cap showed me a spare key under that flowerpot."
						endif
					endif
				endif
			endif
		endif
	endif
else
	msg:Your friends aren't here.
endif

<end node> 5P9i0s8y19Z
