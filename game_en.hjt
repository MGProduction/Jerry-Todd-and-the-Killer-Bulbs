dt=Text
<node>
use
4
ifobjin:$this,$available
	ifisroom:potting_room
		msg:You smash the chair against the window. The glass shatters and the chair splinters.
		set:window_opened
		put:chair,$nowhere
	else
		msg:You don't want to sit down now.

<end node> 5P9i0s8y19Z
dt=Text
<node>
x
4
ifobjin:chair,$inventory
	msg:It's a solid wooden chair.
else
	ifnot:window_opened
		ifisroom:hidden_room
			if:cap_free
				msg:It's a solid wooden chair.
			else
				msg:It's a solid wooden chair, and Cap's on it
			endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
take
4
ifobjin:chair,$inventory
	msg:You already have it.
else
	ifisroom:hidden_room
		if:cap_free
			if:window_opened
				msg:You don't see another one here.
			else
				put:chair,$inventory
				msg:Done.
			endif
		else
			msg:Cap is still sitting on it!
		endif

<end node> 5P9i0s8y19Z
