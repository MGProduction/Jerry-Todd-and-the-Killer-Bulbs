				waitkey
				goto:bill_office
			else
				msg:You try to get out through the side window, but it's blocked.
			endif
		else
			msg:You don't want to leave your friends before they've found a way to slow the attackers.
		endif
	endif
else
	msg:To do what?
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
s
4
if:danger
	msg:Heavy footsteps approach outside. The gang must protect Cap here; you can use the side window.
else
	goto:glasshouse
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
wait
4
if:danger
	if:help_called
		if:bench_set
			if:boards_set
				msg:Mr Bulb throws his weight against the door. Peg holds the bench; Red's braces stay firm. Scoop keeps Cap back. Outside, Bill shouts an order. Help has arrived!
				waitkey
				goto:_end
			else
				addvar:pressure,1
				msg:The bench shifts under a blow. Red points to the loose boards: "Brace it!"
				if:pressure>2
					waitkey
					goto:_caught
				endif
			endif
		else
			addvar:pressure,1
			msg:Mr Bulb is at the glasshouse door. Peg must move the bench before it gives way.
			if:pressure>2
				waitkey
				goto:_caught
			endif
		endif
	else
		msg:Scoop stops the gang from simply waiting. "Jerry, you must fetch Bill first. Use the side window!"
	endif
else
	msg:The boys pause to listen. Nothing moves.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:danger
		if:bench_set
			if:boards_set
				if:window_opened
					msg:Scoop: "The barricade is ready and the window is clear. Jerry, run and fetch Bill!"
				else
					ifobjin:chair,$inventory
						msg:Peg: "Try breaking the window with the chair."
					else
						msg:Red: "The window is stuck. The chair in the room behind the shelf could help us break the glass."
					endif
				endif
			else
				ifobjin:boards,$inventory
					msg:Red: "Let's use the boards to brace the bench."
				else
					msg:Red: "Pick up those boards. We'll use them to brace the bench."
				endif
			endif
		else
			msg:Peg: "I can move the bench against the door. Then we'll brace it."
		endif
	else
		if:shelf_moved
			msg:Scoop: "Let's go through the opening to the east. Cap might be in there."
		else
			if:marks_seen
				msg:Red: "Perhaps the shelf can be moved. Peg could try."
			else
				msg:Red: "Let's take a closer look at that shelf."
			endif
		endif
	endif
else
	msg:Your friends aren't here.
endif

<end node> 5P9i0s8y19Z
