withobj:gang
5
if:withfriends
	if:money_found
		ifobjin:screwdriver,$inventory
			msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
		else
			msg:Red: "Let's take the screwdriver before going back to the nursery."
		endif
	else
		if:gang_reunited
			msg:Scoop: "Let's go back to the villa. We need to find out what those men are hiding."
		else
			if:note_read
				if:ambush_cleared
					msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
				else
					msg:Scoop: "We know where to look for Cap: the nursery."
				endif
			else
				msg:Scoop: "That note on the table might explain where Cap has gone."
			endif
		endif
	endif
else
	msg:The others are waiting to hear from you; they aren't here with you.
endif

