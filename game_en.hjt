			else
				if:note_read
					if:nest_seen
						ifobjin:elastic,$inventory
							ifobjin:stone,$inventory
								msg:Red: "You've got everything you need. Let's go back to the stream path."
							else
								msg:Red: "Now we need a stone. We saw some along the stream bank."
							endif
						else
							msg:Red: "The tomato launcher is broken, but we can detach its rubber band."
						endif
					else
						msg:Scoop: "Let's go back to Cap's porch and find a way to the nursery."
					endif
				else
					msg:Scoop: "Let's go and see Cap. His porch is south of here."
				endif
			endif
		endif
	endif
else
	msg:Your friends aren't here.
endif

