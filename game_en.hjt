call
6
ifobjin:coin,$inventory
	if:villa_known
		if:gang_reunited
			msg:The call has already brought the gang together.
		else
			put:coin,$nowhere
			set:gang_reunited
			set:withfriends
			put:peg,villa_gate
			put:red,villa_gate
			put:scoop,villa_gate
			unset:jerry_alone
			msg:You call Cap's house and tell your friends where you are. "The truck went into a villa. The wall's too high to see what they're doing. Come to the gate, quietly!"
			msg:You return to the gate. A quarter of an hour later, Scoop, Peg and Red join you. Peg studies the wall. "If you want a look over it, I can give you a hand."
			waitkey
			goto:villa_gate
		endif
	else
		msg:There is nobody the gang needs to call from here yet.
	endif
else
	if:gang_reunited
		msg:The call has already brought the gang together.
	else
		msg:You need a coin to use it

