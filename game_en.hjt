<node>
onenter
2
clear
ifundef:$room.shortdesc
	msg:You are in +
	msg:$roomname
else
	msg:You are +
	msg:$room.shortdesc
endif
msg:.
ifundef:$room.exits
	msg:There are no evident exits.
else
	msg:There are clear exits to +
	msg:$room.exits
	msg:.
endif
ifobjinattr:$any,$here,visible+listable
	msg:You see: +
	listobjin:$here,visible+listable
endif
if:withfriends
	ifisin:peg,$here
	else
		msg:Peg, Red and Scoop catch up with you.
	endif
	put:peg,$here
	put:red,$here
	put:scoop,$here
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
onfirst
2
clear
msg:$roomdesc
ifdef:$room.exits	
	msg:There are clear exits to +
	msg:$room.exits
	msg:.
endif
ifobjinattr:$any,$here,visible+listable
	msg:You see: +
	listobjin:$here,visible+listable
endif
if:withfriends
	ifisin:peg,$here
	else
		msg:Peg, Red and Scoop catch up with you.
	endif
	put:peg,$here
	put:red,$here
	put:scoop,$here
endif

