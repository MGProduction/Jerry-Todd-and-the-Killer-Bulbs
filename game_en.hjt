<node>
open
4
ifobjin:$this,$available
	if:crate_dug
		if:money_found
			msg:The bundles of banknotes are still inside. The gang leaves the evidence alone.
		else
			set:money_found
			msg:Peg lifts the lid. Not Cap, but bundles of banknotes!
			msg:Scoop checks the BULB label on the crate.
			msg:"That hat fooled us. Cap must still be at the nursery. These men are hiding their takings."
		endif
	else
		msg:Scoop stops the gang from exposing itself by opening the crate here.
	endif

