6
if:nursery_unlocked
	msg:Red has released the lock. The door will open.
else
	if:bulb_away
		msg:Mrs Bulb locked it when she left. Red studies the small lock.
	else
		msg:Mrs Bulb keeps the private glasshouse closed to visitors.
	endif
endif

