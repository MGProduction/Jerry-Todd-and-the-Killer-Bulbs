use
6
if:danger
	if:help_called
		msg:Bill has been called. You and your friends must hold the room until he can stop Mr Bulb.
	else
		if:boards_set		
			if:window_opened
				set:jerry_away
				unset:withfriends
				set:jerry_alone
				msg:You slip through the side window and race to Bill Hadley. Scoop, Peg and Red stay with Cap while you go for help.
				waitkey
				goto:bill_office
			else
				msg:You try to get out through the side window, but it's blocked.
			endif
		else
			msg:You don't want to leave your friends before they've found a way to slow the attackers.
		endif
	endif
else
	msg:To do what?
endif

