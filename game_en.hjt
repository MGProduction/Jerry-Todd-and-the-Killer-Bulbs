syn:call,telephone
5
<end node> 5P9i0s8y19Z
dt=Text
<node>
e
4
if:jerry_alone
	msg:You must telephone the others before leaving the villa.
else
	goto:town_lane
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:gang_reunited
	if:money_found
		msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
	else
		if:villa_men_gone
			msg:Scoop: "Back to the gate to the north: we can enter the garden now."
		else
			msg:Scoop: "Let's go back to the villa gate to the north. We need to see what those men are doing."
		endif
	endif
else
	ifobjin:coin,$inventory
		msg:You have a coin and know Cap's number. Call your friends and tell them where you are.
	else
		if:coin_found
			msg:The coin is on the ground in the booth. Pick it up to call your friends.
		else
			msg:The others are waiting for your call. Check whether there's anything useful in the booth.
		endif
	endif
endif

<end node> 5P9i0s8y19Z
