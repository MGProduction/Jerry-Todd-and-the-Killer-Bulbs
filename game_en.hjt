3
<end node> 5P9i0s8y19Z
dt=Text
<node>
verb
3
<end node> 5P9i0s8y19Z
dt=Text
<node>
drop
4
ifobjin:$this,$available
	msg:Scoop suggests keeping them until this business is settled.

<end node> 5P9i0s8y19Z
dt=Text
<node>
use
4
ifobjin:$this,$available
	ifisroom:potting_room
		if:boards_set
			msg:The boards are already wedged in place.
		else
			if:danger
				ifobjin:boards,$inventory
					if:bench_set
						if:boards_set
							msg:The boards are already wedged in place.
						else
							set:boards_set
							put:boards,$here
							msg:Red wedges the boards between bench and wall. Scoop tests the brace; this should hold until help arrives.
						endif
					else
						msg:Peg needs to put the bench against the door first.
					endif
				else
					msg:Someone needs to pick that up first.
				endif
			else
				msg:The boards may be useful later.
			endif
		endif
	else
		msg:The boards are needed back in the potting room.
	endif

<end node> 5P9i0s8y19Z
