dt=Text
<node>
onfirst
3
clear
msg:$roomdesc
ifdef:$room.exits	
	msg:There are clear exits to +
	msg:$room.exits
	msg:.
endif
if:withfriends
	ifisin:peg,$here
	else
		msg:Peg, Red and Scoop catch up with you.
	endif
	put:peg,$here
	put:red,$here
	put:scoop,$here
endif
if:ambush_cleared
else
	msg:You stop short. Some Strieker boys are crouching in the bushes at the bend, waiting to ambush the gang. They haven't spotted you yet.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
verb
3
<end node> 5P9i0s8y19Z
dt=Text
<node>
se
4
if:ambush_cleared
	goto:town_lane
else
	msg:Some Strieker boys are crouching in the bushes ahead, waiting to ambush you and your friends. You stop before they spot you. There must be a way to shift them without a fight.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
shoot
4
ifisroom:riverside_path
	if:ambush_cleared
		msg:The Striekers have gone. You leave the wasps alone.
	else
		if:nest_seen
			ifobjin:elastic,$inventory
				ifobjin:stone,$inventory
					set:ambush_cleared
					put:stone,$nowhere
					put:striekers,$nowhere
					msg:You stretch the rubber band, fit the stone and aim at the branch above the Striekers. The shot clips the nest loose. It drops into the bushes; a furious buzzing sends the boys running across the fields.
					msg:You and your friends keep well clear of the wasps and hurry along the stream to the town lane. Mrs Smith and her friends have gone too; both routes to Cap's house are clear now.
					waitkey
					goto:town_lane
				else
					msg:You have the rubber band, but you need a small stone. Smooth stones lie along the stream bank.
				endif
			else
				msg:A hand-thrown stone would be too uncertain. Red remembers the sound rubber band on the broken tomato launcher in the farm courtyard.
			endif
		else
			msg:You need a safe target. You should examine the bushes and branches before trying anything.
		endif
	endif
else
	msg:Peg, Red and Scoop follow you.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
	else
		if:gang_reunited
			msg:Scoop: "Let's go back to the villa. We need to find out what those men are hiding."
		else
			if:ambush_cleared
				msg:Scoop: "The Striekers have run off. The path southeast leads to the town lane; we can reach the nursery from there."
			else
				if:nest_seen
					ifobjin:elastic,$inventory
						ifobjin:stone,$inventory
							msg:Red: "You've got the rubber band and a stone. Try hitting the nest above the Striekers."
						else
							msg:Red: "You've got the rubber band. Pick up one of those smooth stones along the bank."
						endif
					else
						msg:Red: "We need the launcher's rubber band. Let's go back to the barn yard."
					endif
				else
					msg:Peg: "The Striekers are waiting for us to make a mistake. Let's look at the bushes before getting any closer."
				endif
			endif
		endif
	endif
else
	msg:Your friends aren't here.
endif

<end node> 5P9i0s8y19Z
