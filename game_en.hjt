<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:nursery_unlocked
		msg:Scoop: "The door is unlocked. Let's enter the glasshouse to the north."
	else
		if:money_found
			ifobjin:screwdriver,$inventory
				msg:Red: "Let's try working on the lock with Cap's screwdriver."
			else
				msg:Red: "We could use the screwdriver on that lock. Let's go back to Cap's house and get it."
			endif
		else
			if:gang_reunited
				msg:Scoop: "Let's go back to the villa. We need to find out what those men are hiding."
			else
				if:tracks_seen
					msg:Scoop: "Cap was here. Let's hide behind the hedge to the east and see what happens."
				else
					if:bulb_denied
						msg:Red: "Those marks beside the entrance deserve a closer look."
					else
						msg:Scoop: "Let's ask Mrs Bulb if Cap has arrived."
					endif
				endif
			endif
		endif
	endif
else
	msg:Your friends aren't here.
endif

<end node> 5P9i0s8y19Z
dt=Text
