talk
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:red
5
if:!note_read
	if:job_remembered
		msg:Red: "Cap promised us work. Let's go and see him. Ice cream comes after payday."
	else
		set:job_remembered
		msg:Red sits up. "Cap promised to pay us for helping with some jobs!"
		msg:Scoop is already on his feet. "Then we visit Cap. Work first, ice cream afterwards."
	endif
else
	msg:Scoop: "We won't find Cap by staying in the barn. He was called to the nursery."

<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:peg
5
if:!note_read
	if:job_remembered
		msg:Peg: "Cap promised us work. Let's go and see him. Ice cream comes after payday."
	else
		msg:Peg pats his empty pockets. "Not even enough for one scoop."
		msg:Red has a curious look on his face, though.
	endif
else
	msg:Scoop: "We won't find Cap by staying in the barn. He was called to the nursery."

<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:scoop
5
if:!note_read
	if:job_remembered
		msg:Scoop: "Cap promised us work. Let us go see him. Ice cream comes after payday."
	else
		msg:"Absolutely nothing," says Scoop.
		msg:Red has a curious look on his face, though.
	endif
else
	msg:Scoop: "We won't find Cap by staying in the barn. He was called to the nursery."

<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:$none
5
if:!note_read
	if:job_remembered
		msg:Scoop: "Cap promised us work. Let us go see him. Ice cream comes after payday."
	else
		msg:Your friends search their pockets, but in the end they all shake their heads.
		msg:Red has a curious look on his face, though.
	endif
else
	msg:Scoop: "We won't find Cap by staying in the barn. He was called to the nursery."

<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:gang
5
if:withfriends
	if:money_found
		msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
	else
		if:gang_reunited
			msg:Scoop: "Let's go back to the villa. We need to find out what those men are hiding."
		else
			if:ambush_cleared
				msg:Scoop: "Back to the nursery. That's where we need to look for Cap."
			else
				if:note_read
					msg:Scoop: "We won't find Cap by staying in the barn. He was called to the nursery."
				else
					if:job_remembered
						msg:Scoop: "Let's go and see Cap. Work first, ice cream afterwards."
					else
						msg:Peg: "No money, no ice cream. Red, what's that look on your face?"
					endif
				endif
			endif
		endif
	endif
else
	msg:Your friends aren't here.
endif

<end node> 5P9i0s8y19Z
dt=Text
<node>
e
4
if:job_remembered
	goto:red_barn_yard
else
	msg:Scoop stays on his crate. "Before we wander off, let us talk over how to earn our ice cream."
endif

<end node> 5P9i0s8y19Z
